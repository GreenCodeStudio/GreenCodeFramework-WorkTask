<form>
    <div class="topBarButtons">
        <a href=("/WorkTaskProject/edit/":item.id) class="button action-edit"><span class="icon-edit"></span>{{t("CommonBase.edit")}}</a>
    </div>
    <div class="grid page-WorkTaskProject page-WorkTaskProject-show">
        <input name="id" type="hidden" />
        <section class="card action-show" data-width="6">
            <header>
                <h1>{{t("WorkTask.WorkTaskProject.WorkTaskProject")}}</h1>
            </header>
          <div class="pseudoLabel">
            <span>{{t("WorkTask.WorkTaskProject.name")}}:</span>
            <strong>{{item.name}}</strong>
        </div>
        </section>
    <section class="card action-show columnsCard">
        <div class="columns">
            <:foreach collection=item.columns item=column>
                <div class="column">
                    <h2>{{column.name}}</h2>
                    <div class="tasks">

                        <:foreach collection=column.tasks item=task>
                                <a class="task" href="/WorkTask/show/":task.id >
                                    <h3>{{task.title}}</h3>
                                </a>
                        </:foreach>
                    </div>
                    <a href="/WorkTask/add?workTaskColumn_id=":column.id class="button icon-add">{{t("CommonBase.add")}}</a>
                </div>
            </:foreach>
        </div>
    </section>
    </div>
</form>
