<form>
    <div class="topBarButtons">
        <a href="/WorkTaskProject/" class="button"><span class="icon-cancel"></span>{{t("CommonBase.cancel")}}</a>
        <button class=("button action-":type)><span class="icon-save"></span>{{t("CommonBase.save")}}</button>
    </div>
    <div class="grid page-WorkTaskProject page-WorkTaskProject-edit">
        <input name="id" type="hidden" />
        <section class=("card action-":type) data-width="6">
            <header>
                <h1>{{t("WorkTask.WorkTaskProject.WorkTaskProject")}}</h1>
            </header>
          <label>
            <span>{{t("WorkTask.WorkTaskProject.name")}}</span>
            <input type="text" name="name" required />
        </label>
        </section>
    </div>
</form>